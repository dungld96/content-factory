{
  "name": "ai-content-factory",
  "version": "0.0.0",
  "private": true,
  "description": "Low-cost, multi-provider AI content production platform (modular monorepo).",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.28.0 <11"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" -r build",
    "build": "pnpm -r build",
    "dev": "pnpm build:packages && pnpm --parallel --filter @acf/api --filter @acf/web dev",
    "dev:api": "pnpm build:packages && pnpm --filter @acf/api dev",
    "dev:web": "pnpm build:packages && pnpm --filter @acf/web dev",
    "dev:worker": "pnpm build:packages && pnpm --filter @acf/worker build && pnpm --filter @acf/worker start",
    "start:api": "pnpm --filter @acf/api start",
    "start:web": "pnpm --filter @acf/web start",
    "start:worker": "pnpm --filter @acf/worker start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && vitest run --project 'unit:*'",
    "test:watch": "vitest --project 'unit:*'",
    "test:integration": "pnpm build:packages && vitest run --project 'integration:*'",
    "test:drills": "pnpm build:packages && vitest run --project 'integration:*' -t drill",
    "test:e2e": "pnpm --filter @acf/web test:e2e",
    "test:coverage": "pnpm build:packages && vitest run --project 'unit:*' --coverage",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "infra:up": "docker compose -f infra/compose/docker-compose.yml --env-file .env up -d --wait",
    "infra:down": "docker compose -f infra/compose/docker-compose.yml --env-file .env down",
    "infra:reset": "docker compose -f infra/compose/docker-compose.yml --env-file .env down -v",
    "infra:logs": "docker compose -f infra/compose/docker-compose.yml --env-file .env logs -f",
    "db:generate": "pnpm --filter @acf/database db:generate",
    "db:validate": "pnpm --filter @acf/database db:validate",
    "db:migrate": "pnpm --filter @acf/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @acf/database db:migrate:deploy",
    "db:bootstrap": "pnpm build:packages && pnpm --filter @acf/database db:bootstrap",
    "db:setup": "pnpm build:packages && pnpm --filter @acf/database db:setup",
    "db:seed": "pnpm build:packages && pnpm --filter @acf/api build && pnpm --filter @acf/api seed",
    "media:selftest": "pnpm --filter @acf/media build && node packages/media/dist/selftest-cli.js",
    "user:create": "pnpm build:packages && pnpm --filter @acf/api build && pnpm --filter @acf/api user create",
    "user:set-password": "pnpm build:packages && pnpm --filter @acf/api build && pnpm --filter @acf/api user set-password",
    "user:disable": "pnpm build:packages && pnpm --filter @acf/api build && pnpm --filter @acf/api user disable",
    "ai:registry": "pnpm build:packages && pnpm --filter @acf/api build && pnpm --filter @acf/api ai",
    "db:studio": "pnpm --filter @acf/database db:studio",
    "env:check": "pnpm build:packages && node scripts/check-env.mjs",
    "storage:setup": "pnpm --filter @acf/storage build && pnpm --filter @acf/storage storage:setup"
  },
  "devDependencies": {
    "@acf/config": "workspace:*",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@swc/core": "1.16.21",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
