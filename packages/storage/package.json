{
  "name": "@acf/storage",
  "version": "0.0.0",
  "private": true,
  "description": "Object storage (S3 API) and media validation for assets (M4a, ADR-0006).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "default": "./dist/admin.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "storage:setup": "node scripts/storage-setup.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1171.0",
    "image-size": "2.1.0"
  }
}
