// =============================================================================
// AI Content Factory — Prisma schema (M1: domain, persistence, identity & access)
// =============================================================================
// Design: docs/design/M1-design-review-package.md (revision 4), ADR-0009/0010/0011.
// Conventions
// - IDs: UUIDv7 generated by Prisma Client (`uuid(7)`), stored as native `uuid`.
//   Direct-SQL inserts must supply IDs (no database default).
// - Timestamps: `timestamptz(3)`, UTC. `createdAt` everywhere, `updatedAt` on mutable rows.
// - Tables/columns are snake_case via @@map/@map; enum values are snake_case.
// - Deletion: nothing domain-level is hard-deleted. Rows are archived (`archivedAt`).
//   FKs are RESTRICT/RESTRICT; only `sessions.user_id` cascades on delete.
// - Cross-project integrity is enforced by COMPOSITE foreign keys on (project_id, id):
//   a child can only reference a row that belongs to the same project.
// - CHECK constraints, functions and triggers live in migration SQL
//   (migrations/*_init_m1/migration.sql). Prisma does not model them and does not drop them.
//   Changing a guarded table requires reviewing the trigger functions (frozen-column lists).
// - Services write scalar FK columns directly ("unchecked" inputs): relations that share
//   `project_id` overlap, which makes nested `connect` ambiguous.
// =============================================================================

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------- enums

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

enum ProjectRole {
  owner
  editor
  viewer

  @@map("project_role")
}

enum ChannelPlatform {
  tiktok
  instagram_reels
  youtube_shorts
  other

  @@map("channel_platform")
}

enum VersionStatus {
  draft
  approved

  @@map("version_status")
}

enum AssetType {
  reference
  image
  video
  audio
  subtitle
  render

  @@map("asset_type")
}

enum AssetSourceType {
  upload // provided by a user (bytes arrive in M4)
  import // brought in from an external system/URL
  generated // produced by a provider job (M2+; job/provider FKs added then)
  derived // produced from another asset (crop, transcode, ...); requires source_asset_id

  @@map("asset_source_type")
}

enum ApprovalStatus {
  pending
  approved
  rejected
  changes_requested

  @@map("approval_status")
}

/// Canonical list per docs/CONTENT_PIPELINE.md §1 (decision U1).
/// M1 creates items in `draft` only; transitions are implemented in M3.
enum ContentStatus {
  draft
  researching
  planning
  scripting
  script_review
  storyboarding
  storyboard_review
  generating_assets
  asset_review
  rendering
  quality_review
  approved
  exported
  failed
  canceled
  needs_input

  @@map("content_status")
}

enum ContentFormat {
  short_video

  @@map("content_format")
}

enum AspectRatio {
  ratio_9_16 @map("9:16")
  ratio_16_9 @map("16:9")
  ratio_1_1  @map("1:1")

  @@map("aspect_ratio")
}

// ----------------------------------------------------------------------------- identity

model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  /// Normalized (trimmed, lowercased) by the application before write.
  email             String     @unique @db.VarChar(320)
  displayName       String     @map("display_name") @db.VarChar(120)
  /// Argon2id PHC string. Never selected by default queries; never serialized.
  passwordHash      String     @map("password_hash") @db.Text
  status            UserStatus @default(active)
  passwordChangedAt DateTime   @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions             Session[]
  memberships          ProjectMember[]      @relation("MemberUser")
  addedMemberships     ProjectMember[]      @relation("MemberAddedBy")
  createdProjects      Project[]
  createdChannels      Channel[]
  createdCharacters    Character[]
  createdCharVersions  CharacterVersion[]   @relation("CharacterVersionCreatedBy")
  approvedCharVersions CharacterVersion[]   @relation("CharacterVersionApprovedBy")
  createdEnvironments  Environment[]
  createdEnvVersions   EnvironmentVersion[] @relation("EnvironmentVersionCreatedBy")
  approvedEnvVersions  EnvironmentVersion[] @relation("EnvironmentVersionApprovedBy")
  createdAssets        Asset[]
  createdContentItems  ContentItem[]

  @@map("users")
}

/// express-session store rows. Only authenticated sessions are persisted
/// (saveUninitialized=false). The raw session ID never reaches the database.
model Session {
  /// SHA-256 of the express-session ID (32 bytes). Lookup key.
  idHash            Bytes    @id @map("id_hash") @db.ByteA
  userId            String   @map("user_id") @db.Uuid
  /// Allow-listed payload only: { cookie, userId, authenticatedAt }. No secrets.
  data              Json     @db.JsonB
  /// Idle expiry (rolling). Rows past this are treated as absent.
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(3)
  /// Hard upper bound set at login (createdAt + 7 days); never extended.
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ----------------------------------------------------------------------------- workspace

model Project {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String    @db.VarChar(120)
  /// Globally unique (D12).
  slug            String    @unique @db.VarChar(80)
  description     String?   @db.Text
  /// BCP 47 tag, validated by the API (e.g. "vi", "en-US").
  defaultLanguage String    @map("default_language") @db.VarChar(35)
  /// IANA time zone, validated by the API (e.g. "Asia/Ho_Chi_Minh").
  timezone        String    @db.VarChar(64)
  createdById     String    @map("created_by_id") @db.Uuid
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy    User            @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  members      ProjectMember[]
  channels     Channel[]
  characters   Character[]
  environments Environment[]
  assets       Asset[]
  contentItems ContentItem[]

  @@index([createdById])
  @@map("projects")
}

model ProjectMember {
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole
  addedById String?     @map("added_by_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user    User    @relation("MemberUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  addedBy User?   @relation("MemberAddedBy", fields: [addedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([projectId, userId])
  @@index([userId])
  @@index([projectId, role])
  @@map("project_members")
}

model Channel {
  id          String          @id @default(uuid(7)) @db.Uuid
  projectId   String          @map("project_id") @db.Uuid
  name        String          @db.VarChar(120)
  slug        String          @db.VarChar(80)
  platform    ChannelPlatform
  handle      String?         @db.VarChar(120)
  description String?         @db.Text
  createdById String          @map("created_by_id") @db.Uuid
  archivedAt  DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contentItems ContentItem[]

  @@unique([projectId, slug])
  @@unique([projectId, id]) // composite-FK target
  @@index([createdById])
  @@map("channels")
}

// ----------------------------------------------------------------------------- characters

model Character {
  id              String    @id @default(uuid(7)) @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  name            String    @db.VarChar(120)
  slug            String    @db.VarChar(80)
  description     String?   @db.Text
  /// Denormalized pointer to the master (= highest-numbered approved) version.
  /// Written only inside the approval transaction; guarded by trigger.
  masterVersionId String?   @map("master_version_id") @db.Uuid
  createdById     String    @map("created_by_id") @db.Uuid
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  project       Project            @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy     User               @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versions      CharacterVersion[] @relation("CharacterVersions")
  /// Composite FK (id, master_version_id) -> character_versions(character_id, id):
  /// the master must be a version of THIS character.
  masterVersion CharacterVersion?  @relation("CharacterMaster", fields: [id, masterVersionId], references: [characterId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([projectId, slug])
  @@unique([projectId, id]) // composite-FK target
  @@index([masterVersionId])
  @@index([createdById])
  @@map("characters")
}

model CharacterVersion {
  id               String        @id @default(uuid(7)) @db.Uuid
  projectId        String        @map("project_id") @db.Uuid
  characterId      String        @map("character_id") @db.Uuid
  version          Int
  status           VersionStatus @default(draft)
  description      String        @db.Text
  identityRules    Json          @default("{}") @map("identity_rules") @db.JsonB
  /// The master reference image for this version (optional). Same-project via composite FK.
  primaryAssetId   String?       @map("primary_asset_id") @db.Uuid
  /// Lineage: the version this draft was copied from (rollback = new draft based on an old one).
  basedOnVersionId String?       @map("based_on_version_id") @db.Uuid
  createdById      String        @map("created_by_id") @db.Uuid
  approvedById     String?       @map("approved_by_id") @db.Uuid
  approvedAt       DateTime?     @map("approved_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  character     Character               @relation("CharacterVersions", fields: [projectId, characterId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  masterOf      Character[]             @relation("CharacterMaster") // at most one by construction (composite FK)
  primaryAsset  Asset?                  @relation("CharacterVersionPrimaryAsset", fields: [projectId, primaryAssetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  basedOn       CharacterVersion?       @relation("CharacterVersionLineage", fields: [characterId, basedOnVersionId], references: [characterId, id], onDelete: Restrict, onUpdate: Restrict)
  derivedDrafts CharacterVersion[]      @relation("CharacterVersionLineage")
  createdBy     User                    @relation("CharacterVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedBy    User?                   @relation("CharacterVersionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assets        CharacterVersionAsset[]

  @@unique([characterId, version])
  @@unique([characterId, id]) // composite-FK target (master pointer, lineage)
  @@unique([projectId, id]) // composite-FK target (asset links)
  @@index([primaryAssetId])
  @@index([createdById])
  @@index([approvedById])
  @@map("character_versions")
}

/// Additional reference assets for a version. Frozen when the version is approved.
model CharacterVersionAsset {
  projectId          String   @map("project_id") @db.Uuid
  characterVersionId String   @map("character_version_id") @db.Uuid
  assetId            String   @map("asset_id") @db.Uuid
  sortOrder          Int      @default(0) @map("sort_order")
  note               String?  @db.VarChar(500)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  version CharacterVersion @relation(fields: [projectId, characterVersionId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  asset   Asset            @relation("CharacterVersionAssets", fields: [projectId, assetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([characterVersionId, assetId])
  @@index([assetId])
  @@map("character_version_assets")
}

// ----------------------------------------------------------------------------- environments

model Environment {
  id              String    @id @default(uuid(7)) @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  name            String    @db.VarChar(120)
  slug            String    @db.VarChar(80)
  description     String?   @db.Text
  masterVersionId String?   @map("master_version_id") @db.Uuid
  createdById     String    @map("created_by_id") @db.Uuid
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  project       Project              @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy     User                 @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versions      EnvironmentVersion[] @relation("EnvironmentVersions")
  masterVersion EnvironmentVersion?  @relation("EnvironmentMaster", fields: [id, masterVersionId], references: [environmentId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([projectId, slug])
  @@unique([projectId, id])
  @@index([masterVersionId])
  @@index([createdById])
  @@map("environments")
}

model EnvironmentVersion {
  id               String        @id @default(uuid(7)) @db.Uuid
  projectId        String        @map("project_id") @db.Uuid
  environmentId    String        @map("environment_id") @db.Uuid
  version          Int
  status           VersionStatus @default(draft)
  description      String        @db.Text
  visualRules      Json          @default("{}") @map("visual_rules") @db.JsonB
  primaryAssetId   String?       @map("primary_asset_id") @db.Uuid
  basedOnVersionId String?       @map("based_on_version_id") @db.Uuid
  createdById      String        @map("created_by_id") @db.Uuid
  approvedById     String?       @map("approved_by_id") @db.Uuid
  approvedAt       DateTime?     @map("approved_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  environment   Environment               @relation("EnvironmentVersions", fields: [projectId, environmentId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  masterOf      Environment[]             @relation("EnvironmentMaster") // at most one by construction
  primaryAsset  Asset?                    @relation("EnvironmentVersionPrimaryAsset", fields: [projectId, primaryAssetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  basedOn       EnvironmentVersion?       @relation("EnvironmentVersionLineage", fields: [environmentId, basedOnVersionId], references: [environmentId, id], onDelete: Restrict, onUpdate: Restrict)
  derivedDrafts EnvironmentVersion[]      @relation("EnvironmentVersionLineage")
  createdBy     User                      @relation("EnvironmentVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedBy    User?                     @relation("EnvironmentVersionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assets        EnvironmentVersionAsset[]

  @@unique([environmentId, version])
  @@unique([environmentId, id])
  @@unique([projectId, id])
  @@index([primaryAssetId])
  @@index([createdById])
  @@index([approvedById])
  @@map("environment_versions")
}

model EnvironmentVersionAsset {
  projectId            String   @map("project_id") @db.Uuid
  environmentVersionId String   @map("environment_version_id") @db.Uuid
  assetId              String   @map("asset_id") @db.Uuid
  sortOrder            Int      @default(0) @map("sort_order")
  note                 String?  @db.VarChar(500)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  version EnvironmentVersion @relation(fields: [projectId, environmentVersionId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  asset   Asset              @relation("EnvironmentVersionAssets", fields: [projectId, assetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([environmentVersionId, assetId])
  @@index([assetId])
  @@map("environment_version_assets")
}

// ----------------------------------------------------------------------------- assets

model Asset {
  id               String          @id @default(uuid(7)) @db.Uuid
  projectId        String          @map("project_id") @db.Uuid
  contentItemId    String?         @map("content_item_id") @db.Uuid
  assetType        AssetType       @map("asset_type")
  sourceType       AssetSourceType @map("source_type")
  /// Lineage parent (same project via composite FK). Immutable; set at insert.
  sourceAssetId    String?         @map("source_asset_id") @db.Uuid
  /// Free-text provenance for upload/import (e.g. "photographer X, licensed 2026-11").
  sourceNote       String?         @map("source_note") @db.VarChar(1000)
  // --- file identity: immutable after insert (trigger) ---
  storageKey       String          @unique @map("storage_key") @db.VarChar(1024)
  mimeType         String          @map("mime_type") @db.VarChar(255)
  sizeBytes        BigInt          @map("size_bytes")
  checksumSha256   String          @map("checksum_sha256") @db.Char(64)
  width            Int?
  height           Int?
  durationMs       Int?            @map("duration_ms")
  originalFilename String?         @map("original_filename") @db.VarChar(255)
  // --- mutable descriptive fields ---
  label            String?         @db.VarChar(200)
  metadata         Json            @default("{}") @db.JsonB
  approvalStatus   ApprovalStatus  @default(pending) @map("approval_status")
  createdById      String          @map("created_by_id") @db.Uuid
  archivedAt       DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contentItem ContentItem? @relation(fields: [projectId, contentItemId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  sourceAsset Asset?       @relation("AssetLineage", fields: [projectId, sourceAssetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  derived     Asset[]      @relation("AssetLineage")
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  characterVersionPrimary   CharacterVersion[]        @relation("CharacterVersionPrimaryAsset")
  characterVersionLinks     CharacterVersionAsset[]   @relation("CharacterVersionAssets")
  environmentVersionPrimary EnvironmentVersion[]      @relation("EnvironmentVersionPrimaryAsset")
  environmentVersionLinks   EnvironmentVersionAsset[] @relation("EnvironmentVersionAssets")

  @@unique([projectId, id]) // composite-FK target
  @@index([projectId, createdAt(sort: Desc), id(sort: Desc)]) // list/pagination
  @@index([projectId, assetType])
  @@index([contentItemId])
  @@index([sourceAssetId]) // forward lineage traversal (children of an asset)
  @@index([createdById])
  @@map("assets")
}

// ----------------------------------------------------------------------------- content

model ContentItem {
  id                    String        @id @default(uuid(7)) @db.Uuid
  projectId             String        @map("project_id") @db.Uuid
  channelId             String?       @map("channel_id") @db.Uuid
  title                 String        @db.VarChar(200)
  status                ContentStatus @default(draft)
  format                ContentFormat
  targetDurationSeconds Int           @map("target_duration_seconds")
  aspectRatio           AspectRatio   @map("aspect_ratio")
  /// BCP 47 tag.
  language              String        @db.VarChar(35)
  /// Brief JSON validated by the contracts schema (topic, audience, objective, tone, ...).
  brief                 Json          @db.JsonB
  createdById           String        @map("created_by_id") @db.Uuid
  archivedAt            DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  channel   Channel? @relation(fields: [projectId, channelId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assets    Asset[]

  @@unique([projectId, id]) // composite-FK target
  @@index([projectId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([channelId])
  @@index([createdById])
  @@map("content_items")
}
