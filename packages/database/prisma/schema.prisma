// =============================================================================
// AI Content Factory — Prisma schema (M1: domain, persistence, identity & access;
// M2: AI registry and usage ledger, docs/design/M2-design-review-package.md, ADR-0012)
// =============================================================================
// Design: docs/design/M1-design-review-package.md (revision 4), ADR-0009/0010/0011.
// Conventions
// - IDs: UUIDv7 generated by Prisma Client (`uuid(7)`), stored as native `uuid`.
//   Direct-SQL inserts must supply IDs (no database default).
// - Timestamps: `timestamptz(3)`, UTC. `createdAt` everywhere, `updatedAt` on mutable rows.
// - Tables/columns are snake_case via @@map/@map; enum values are snake_case.
// - Deletion: nothing domain-level is hard-deleted. Rows are archived (`archivedAt`).
//   FKs are RESTRICT/RESTRICT; only `sessions.user_id` cascades on delete.
// - Cross-project integrity is enforced by COMPOSITE foreign keys on (project_id, id):
//   a child can only reference a row that belongs to the same project.
// - CHECK constraints, functions and triggers live in migration SQL
//   (migrations/*_init_m1/migration.sql). Prisma does not model them and does not drop them.
//   Changing a guarded table requires reviewing the trigger functions (frozen-column lists).
// - Services write scalar FK columns directly ("unchecked" inputs): relations that share
//   `project_id` overlap, which makes nested `connect` ambiguous.
// =============================================================================

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------- enums

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

enum ProjectRole {
  owner
  editor
  viewer

  @@map("project_role")
}

enum ChannelPlatform {
  tiktok
  instagram_reels
  youtube_shorts
  other

  @@map("channel_platform")
}

enum VersionStatus {
  draft
  approved

  @@map("version_status")
}

enum AssetType {
  reference
  image
  video
  audio
  subtitle
  render

  @@map("asset_type")
}

enum AssetSourceType {
  upload // provided by a user (bytes arrive in M4)
  import // brought in from an external system/URL
  generated // produced by a provider job (M2+; job/provider FKs added then)
  derived // produced from another asset (crop, transcode, ...); requires source_asset_id

  @@map("asset_source_type")
}

enum ApprovalStatus {
  pending
  approved
  rejected
  changes_requested

  @@map("approval_status")
}

/// Canonical list per docs/CONTENT_PIPELINE.md §1 (decision U1).
/// M1 creates items in `draft` only; transitions are implemented in M3.
enum ContentStatus {
  draft
  researching
  planning
  scripting
  script_review
  storyboarding
  storyboard_review
  generating_assets
  asset_review
  rendering
  quality_review
  approved
  exported
  failed
  canceled
  needs_input

  @@map("content_status")
}

enum ContentFormat {
  short_video

  @@map("content_format")
}

enum AspectRatio {
  ratio_9_16 @map("9:16")
  ratio_16_9 @map("16:9")
  ratio_1_1  @map("1:1")

  @@map("aspect_ratio")
}

// ----------------------------------------------------------------------------- identity

model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  /// Normalized (trimmed, lowercased) by the application before write.
  email             String     @unique @db.VarChar(320)
  displayName       String     @map("display_name") @db.VarChar(120)
  /// Argon2id PHC string. Never selected by default queries; never serialized.
  passwordHash      String     @map("password_hash") @db.Text
  status            UserStatus @default(active)
  passwordChangedAt DateTime   @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions              Session[]
  memberships           ProjectMember[]      @relation("MemberUser")
  addedMemberships      ProjectMember[]      @relation("MemberAddedBy")
  createdProjects       Project[]
  createdChannels       Channel[]
  createdCharacters     Character[]
  createdCharVersions   CharacterVersion[]   @relation("CharacterVersionCreatedBy")
  approvedCharVersions  CharacterVersion[]   @relation("CharacterVersionApprovedBy")
  createdEnvironments   Environment[]
  createdEnvVersions    EnvironmentVersion[] @relation("EnvironmentVersionCreatedBy")
  approvedEnvVersions   EnvironmentVersion[] @relation("EnvironmentVersionApprovedBy")
  createdAssets         Asset[]
  createdContentItems   ContentItem[]
  createdContentMasters ContentMaster[]
  createdAiPrices       AiModelPrice[]

  requestedRuns       ProductionRun[]
  requestedJobs       GenerationJob[]
  createdScripts      ScriptVersion[]     @relation("ScriptCreatedBy")
  reviewedScripts     ScriptVersion[]     @relation("ScriptReviewedBy")
  createdStoryboards  StoryboardVersion[] @relation("StoryboardCreatedBy")
  reviewedStoryboards StoryboardVersion[] @relation("StoryboardReviewedBy")
  updatedTaskRoutes   AiTaskRoute[]

  reviewedAssets     Asset[]               @relation("AssetReviewedBy")
  selectedKeyframes  SceneKeyframe[]
  keyframeEvents     SceneKeyframeEvent[]
  selectedClips      SceneClip[]
  clipEvents         SceneClipEvent[]
  selectedVoiceovers SceneVoiceover[]
  voiceoverEvents    SceneVoiceoverEvent[]
  voiceProfiles      VoiceProfile[]
  rendersReviewed    Render[]              @relation("RenderReviewedBy")
  rendersExported    Render[]              @relation("RenderExportedBy")
  rendersCreated     Render[]              @relation("RenderCreatedBy")

  @@map("users")
}

/// express-session store rows. Only authenticated sessions are persisted
/// (saveUninitialized=false). The raw session ID never reaches the database.
model Session {
  /// SHA-256 of the express-session ID (32 bytes). Lookup key.
  idHash            Bytes    @id @map("id_hash") @db.ByteA
  userId            String   @map("user_id") @db.Uuid
  /// Allow-listed payload only: { cookie, userId, authenticatedAt }. No secrets.
  data              Json     @db.JsonB
  /// Idle expiry (rolling). Rows past this are treated as absent.
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(3)
  /// Hard upper bound set at login (createdAt + 7 days); never extended.
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ----------------------------------------------------------------------------- workspace

model Project {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String    @db.VarChar(120)
  /// Globally unique (D12).
  slug            String    @unique @db.VarChar(80)
  description     String?   @db.Text
  /// BCP 47 tag, validated by the API (e.g. "vi", "en-US").
  defaultLanguage String    @map("default_language") @db.VarChar(35)
  /// IANA time zone, validated by the API (e.g. "Asia/Ho_Chi_Minh").
  timezone        String    @db.VarChar(64)
  createdById     String    @map("created_by_id") @db.Uuid
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy     User            @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  members       ProjectMember[]
  channels      Channel[]
  characters    Character[]
  environments  Environment[]
  assets        Asset[]
  contentItems  ContentItem[]
  aiInvocations AiInvocation[]

  contentMasters ContentMaster[]
  productionRuns ProductionRun[]
  generationJobs GenerationJob[]
  voiceProfiles  VoiceProfile[]
  renders        Render[]

  @@index([createdById])
  @@map("projects")
}

model ProjectMember {
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole
  addedById String?     @map("added_by_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user    User    @relation("MemberUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  addedBy User?   @relation("MemberAddedBy", fields: [addedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([projectId, userId])
  @@index([userId])
  @@index([projectId, role])
  @@map("project_members")
}

model Channel {
  id          String          @id @default(uuid(7)) @db.Uuid
  projectId   String          @map("project_id") @db.Uuid
  name        String          @db.VarChar(120)
  slug        String          @db.VarChar(80)
  platform    ChannelPlatform
  handle      String?         @db.VarChar(120)
  description String?         @db.Text
  createdById String          @map("created_by_id") @db.Uuid
  archivedAt  DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contentItems ContentItem[]

  @@unique([projectId, slug])
  @@unique([projectId, id]) // composite-FK target
  @@index([createdById])
  @@map("channels")
}

// ----------------------------------------------------------------------------- characters

model Character {
  id              String    @id @default(uuid(7)) @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  name            String    @db.VarChar(120)
  slug            String    @db.VarChar(80)
  description     String?   @db.Text
  /// Denormalized pointer to the master (= highest-numbered approved) version.
  /// Written only inside the approval transaction; guarded by trigger.
  masterVersionId String?   @map("master_version_id") @db.Uuid
  createdById     String    @map("created_by_id") @db.Uuid
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  project       Project            @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy     User               @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versions      CharacterVersion[] @relation("CharacterVersions")
  /// Composite FK (id, master_version_id) -> character_versions(character_id, id):
  /// the master must be a version of THIS character.
  masterVersion CharacterVersion?  @relation("CharacterMaster", fields: [id, masterVersionId], references: [characterId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([projectId, slug])
  @@unique([projectId, id]) // composite-FK target
  @@index([masterVersionId])
  @@index([createdById])
  @@map("characters")
}

model CharacterVersion {
  id               String        @id @default(uuid(7)) @db.Uuid
  projectId        String        @map("project_id") @db.Uuid
  characterId      String        @map("character_id") @db.Uuid
  version          Int
  status           VersionStatus @default(draft)
  description      String        @db.Text
  identityRules    Json          @default("{}") @map("identity_rules") @db.JsonB
  /// The master reference image for this version (optional). Same-project via composite FK.
  primaryAssetId   String?       @map("primary_asset_id") @db.Uuid
  /// Lineage: the version this draft was copied from (rollback = new draft based on an old one).
  basedOnVersionId String?       @map("based_on_version_id") @db.Uuid
  createdById      String        @map("created_by_id") @db.Uuid
  approvedById     String?       @map("approved_by_id") @db.Uuid
  approvedAt       DateTime?     @map("approved_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  character     Character               @relation("CharacterVersions", fields: [projectId, characterId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  masterOf      Character[]             @relation("CharacterMaster") // at most one by construction (composite FK)
  primaryAsset  Asset?                  @relation("CharacterVersionPrimaryAsset", fields: [projectId, primaryAssetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  basedOn       CharacterVersion?       @relation("CharacterVersionLineage", fields: [characterId, basedOnVersionId], references: [characterId, id], onDelete: Restrict, onUpdate: Restrict)
  derivedDrafts CharacterVersion[]      @relation("CharacterVersionLineage")
  createdBy     User                    @relation("CharacterVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedBy    User?                   @relation("CharacterVersionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assets        CharacterVersionAsset[]

  storyboardScenes StoryboardScene[]

  @@unique([characterId, version])
  @@unique([characterId, id]) // composite-FK target (master pointer, lineage)
  @@unique([projectId, id]) // composite-FK target (asset links)
  @@index([primaryAssetId])
  @@index([createdById])
  @@index([approvedById])
  @@map("character_versions")
}

/// Additional reference assets for a version. Frozen when the version is approved.
model CharacterVersionAsset {
  projectId          String   @map("project_id") @db.Uuid
  characterVersionId String   @map("character_version_id") @db.Uuid
  assetId            String   @map("asset_id") @db.Uuid
  sortOrder          Int      @default(0) @map("sort_order")
  note               String?  @db.VarChar(500)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  version CharacterVersion @relation(fields: [projectId, characterVersionId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  asset   Asset            @relation("CharacterVersionAssets", fields: [projectId, assetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([characterVersionId, assetId])
  @@index([assetId])
  @@map("character_version_assets")
}

// ----------------------------------------------------------------------------- environments

model Environment {
  id              String    @id @default(uuid(7)) @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  name            String    @db.VarChar(120)
  slug            String    @db.VarChar(80)
  description     String?   @db.Text
  masterVersionId String?   @map("master_version_id") @db.Uuid
  createdById     String    @map("created_by_id") @db.Uuid
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  project       Project              @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy     User                 @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versions      EnvironmentVersion[] @relation("EnvironmentVersions")
  masterVersion EnvironmentVersion?  @relation("EnvironmentMaster", fields: [id, masterVersionId], references: [environmentId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([projectId, slug])
  @@unique([projectId, id])
  @@index([masterVersionId])
  @@index([createdById])
  @@map("environments")
}

model EnvironmentVersion {
  id               String        @id @default(uuid(7)) @db.Uuid
  projectId        String        @map("project_id") @db.Uuid
  environmentId    String        @map("environment_id") @db.Uuid
  version          Int
  status           VersionStatus @default(draft)
  description      String        @db.Text
  visualRules      Json          @default("{}") @map("visual_rules") @db.JsonB
  primaryAssetId   String?       @map("primary_asset_id") @db.Uuid
  basedOnVersionId String?       @map("based_on_version_id") @db.Uuid
  createdById      String        @map("created_by_id") @db.Uuid
  approvedById     String?       @map("approved_by_id") @db.Uuid
  approvedAt       DateTime?     @map("approved_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  environment   Environment               @relation("EnvironmentVersions", fields: [projectId, environmentId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  masterOf      Environment[]             @relation("EnvironmentMaster") // at most one by construction
  primaryAsset  Asset?                    @relation("EnvironmentVersionPrimaryAsset", fields: [projectId, primaryAssetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  basedOn       EnvironmentVersion?       @relation("EnvironmentVersionLineage", fields: [environmentId, basedOnVersionId], references: [environmentId, id], onDelete: Restrict, onUpdate: Restrict)
  derivedDrafts EnvironmentVersion[]      @relation("EnvironmentVersionLineage")
  createdBy     User                      @relation("EnvironmentVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedBy    User?                     @relation("EnvironmentVersionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assets        EnvironmentVersionAsset[]

  storyboardScenes StoryboardScene[]

  @@unique([environmentId, version])
  @@unique([environmentId, id])
  @@unique([projectId, id])
  @@index([primaryAssetId])
  @@index([createdById])
  @@index([approvedById])
  @@map("environment_versions")
}

model EnvironmentVersionAsset {
  projectId            String   @map("project_id") @db.Uuid
  environmentVersionId String   @map("environment_version_id") @db.Uuid
  assetId              String   @map("asset_id") @db.Uuid
  sortOrder            Int      @default(0) @map("sort_order")
  note                 String?  @db.VarChar(500)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  version EnvironmentVersion @relation(fields: [projectId, environmentVersionId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  asset   Asset              @relation("EnvironmentVersionAssets", fields: [projectId, assetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([environmentVersionId, assetId])
  @@index([assetId])
  @@map("environment_version_assets")
}

// ----------------------------------------------------------------------------- assets

model Asset {
  id                String          @id @default(uuid(7)) @db.Uuid
  projectId         String          @map("project_id") @db.Uuid
  contentItemId     String?         @map("content_item_id") @db.Uuid
  assetType         AssetType       @map("asset_type")
  sourceType        AssetSourceType @map("source_type")
  /// Lineage parent (same project via composite FK). Immutable; set at insert.
  sourceAssetId     String?         @map("source_asset_id") @db.Uuid
  /// Free-text provenance for upload/import (e.g. "photographer X, licensed 2026-11").
  sourceNote        String?         @map("source_note") @db.VarChar(1000)
  // --- file identity: immutable after insert (trigger) ---
  storageKey        String          @unique @map("storage_key") @db.VarChar(1024)
  mimeType          String          @map("mime_type") @db.VarChar(255)
  sizeBytes         BigInt          @map("size_bytes")
  checksumSha256    String          @map("checksum_sha256") @db.Char(64)
  width             Int?
  height            Int?
  durationMs        Int?            @map("duration_ms")
  originalFilename  String?         @map("original_filename") @db.VarChar(255)
  // --- mutable descriptive fields ---
  label             String?         @db.VarChar(200)
  metadata          Json            @default("{}") @db.JsonB
  approvalStatus    ApprovalStatus  @default(pending) @map("approval_status")
  /// Who reviewed the asset and when (M4: image candidates and uploads).
  reviewedById      String?         @map("reviewed_by_id") @db.Uuid
  reviewedAt        DateTime?       @map("reviewed_at") @db.Timestamptz(3)
  /// The generation job that produced the asset; required iff source_type = generated (M4).
  generationJobId   String?         @map("generation_job_id") @db.Uuid
  /// The storyboard scene a generated candidate was made for (M4).
  storyboardSceneId String?         @map("storyboard_scene_id") @db.Uuid
  createdById       String          @map("created_by_id") @db.Uuid
  archivedAt        DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  project          Project               @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contentItem      ContentItem?          @relation(fields: [projectId, contentItemId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  sourceAsset      Asset?                @relation("AssetLineage", fields: [projectId, sourceAssetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  derived          Asset[]               @relation("AssetLineage")
  createdBy        User                  @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewedBy       User?                 @relation("AssetReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  generationJob    GenerationJob?        @relation("JobAssets", fields: [projectId, generationJobId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  storyboardScene  StoryboardScene?      @relation("SceneCandidates", fields: [projectId, storyboardSceneId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  inputs           AssetInput[]          @relation("AssetInputsOf")
  renderVideos     Render[]              @relation("RenderVideo")
  renderSubtitles  Render[]              @relation("RenderSubtitle")
  renderThumbnails Render[]              @relation("RenderThumbnail")
  usedAsInput      AssetInput[]          @relation("AssetInputsUsed")
  keyframeOf       SceneKeyframe[]
  keyframeEvents   SceneKeyframeEvent[]
  clipOf           SceneClip[]
  clipEvents       SceneClipEvent[]
  voiceoverOf      SceneVoiceover[]
  voiceoverEvents  SceneVoiceoverEvent[]

  characterVersionPrimary   CharacterVersion[]        @relation("CharacterVersionPrimaryAsset")
  characterVersionLinks     CharacterVersionAsset[]   @relation("CharacterVersionAssets")
  environmentVersionPrimary EnvironmentVersion[]      @relation("EnvironmentVersionPrimaryAsset")
  environmentVersionLinks   EnvironmentVersionAsset[] @relation("EnvironmentVersionAssets")

  sceneReferences StoryboardSceneAsset[]

  @@unique([projectId, id]) // composite-FK target
  @@index([projectId, createdAt(sort: Desc), id(sort: Desc)]) // list/pagination
  @@index([projectId, assetType])
  @@index([contentItemId])
  @@index([sourceAssetId]) // forward lineage traversal (children of an asset)
  @@index([createdById])
  @@index([generationJobId])
  @@index([storyboardSceneId])
  @@index([reviewedById])
  @@map("assets")
}

// ----------------------------------------------------------------------------- content

/// The shared idea of one or more variants (R0; docs/design/M3.5-multiformat-architecture-review.md
/// §3, ADR-0015): brief, sources, references. Format- and platform-free.
model ContentMaster {
  id            String    @id @default(uuid(7)) @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  title         String    @db.VarChar(200)
  /// Shared brief (contracts `contentBriefSchema`); copied into each variant at creation.
  brief         Json      @db.JsonB
  /// Grows by one with every change of `brief`; variants record the revision they copied.
  briefRevision Int       @default(1) @map("brief_revision")
  /// Default language (BCP 47) for new variants.
  language      String    @db.VarChar(35)
  createdById   String    @map("created_by_id") @db.Uuid
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User          @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  variants  ContentItem[]

  @@unique([projectId, id]) // composite-FK target
  @@index([projectId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdById])
  @@map("content_masters")
}

/// A content variant (R0): one deliverable of a content master.
model ContentItem {
  id                    String        @id @default(uuid(7)) @db.Uuid
  projectId             String        @map("project_id") @db.Uuid
  channelId             String?       @map("channel_id") @db.Uuid
  title                 String        @db.VarChar(200)
  status                ContentStatus @default(draft)
  format                ContentFormat
  targetDurationSeconds Int           @map("target_duration_seconds")
  aspectRatio           AspectRatio   @map("aspect_ratio")
  /// BCP 47 tag.
  language              String        @db.VarChar(35)
  /// Brief JSON validated by the contracts schema (topic, audience, objective, tone, ...).
  brief                 Json          @db.JsonB
  createdById           String        @map("created_by_id") @db.Uuid
  archivedAt            DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// The master this variant belongs to (R0). Same project; never changes (AC014).
  contentMasterId     String           @map("content_master_id") @db.Uuid
  /// Target platform when no channel is set; NULL when a channel is set, whose platform then
  /// applies (CHECK `content_items_platform_xor_channel`).
  targetPlatform      ChannelPlatform? @map("target_platform")
  /// The master `brief_revision` this variant's brief was copied from (staleness).
  masterBriefRevision Int              @default(1) @map("master_brief_revision")

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contentMaster ContentMaster  @relation(fields: [projectId, contentMasterId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  channel       Channel?       @relation(fields: [projectId, channelId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy     User           @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assets        Asset[]
  aiInvocations AiInvocation[]

  /// Gate 1 (ADR-0005): the approved script in use. Moves on approval (M3 Q3).
  approvedScriptVersionId     String?             @map("approved_script_version_id") @db.Uuid
  /// Gate 2: the approved storyboard; its script is the approved script (AC013).
  approvedStoryboardVersionId String?             @map("approved_storyboard_version_id") @db.Uuid
  approvedScript              ScriptVersion?      @relation("ContentApprovedScript", fields: [id, approvedScriptVersionId], references: [contentItemId, id], onDelete: Restrict, onUpdate: Restrict)
  approvedStoryboard          StoryboardVersion?  @relation("ContentApprovedStoryboard", fields: [id, approvedStoryboardVersionId], references: [contentItemId, id], onDelete: Restrict, onUpdate: Restrict)
  scriptVersions              ScriptVersion[]     @relation("ContentScripts")
  storyboardVersions          StoryboardVersion[] @relation("ContentStoryboards")
  productionRuns              ProductionRun[]
  generationJobs              GenerationJob[]

  /// Narration voice for TTS (M5 design §7.1); a voice profile of the same project.
  voiceProfileId   String?       @map("voice_profile_id") @db.Uuid
  voiceProfile     VoiceProfile? @relation(fields: [projectId, voiceProfileId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  /// M6 gate 5: the approved render (an approved render of this item; trigger AC017).
  approvedRenderId String?       @map("approved_render_id") @db.Uuid
  approvedRender   Render?       @relation("ContentApprovedRender", fields: [id, approvedRenderId], references: [contentItemId, id], onDelete: Restrict, onUpdate: Restrict)
  renders          Render[]      @relation("ContentRenders")

  @@unique([projectId, id]) // composite-FK target
  @@index([projectId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([channelId])
  @@index([createdById])
  @@index([contentMasterId])
  @@index([voiceProfileId])
  @@map("content_items")
}

// ----------------------------------------------------------------------------- AI registry (M2)
// Design: docs/design/M2-design-review-package.md §6, ADR-0012. Money is exact decimal USD
// (NUMERIC(38,18)). Prices and usage records are append-only; invocations are written before the
// provider call and updated once with the outcome (trigger `acf_ai_ledger_guard`, AC011).

enum AiCapability {
  llm
  image_generation
  image_edit
  video_generation
  tts
  transcription
  vision_evaluation

  @@map("ai_capability")
}

enum AiProviderStatus {
  enabled
  disabled
  degraded

  @@map("ai_provider_status")
}

enum AiQualityTier {
  economy
  balanced
  premium

  @@map("ai_quality_tier")
}

enum AiPriceMetric {
  input_tokens
  output_tokens
  cached_input_tokens
  cache_write_tokens
  reasoning_tokens
  request
  // Image generation (M4; docs/design/m4/openrouter-image-verification.md)
  output_images
  input_images
  /// Per-megapixel prices are stored per pixel, so usage quantities stay integers.
  output_pixels
  input_pixels
  output_image_tokens
  input_image_tokens
  // Video and TTS (M5; docs/design/m5/openrouter-video-tts-verification.md)
  /// Per output second; variant = resolution and audio (e.g. `720p-silent`).
  output_video_seconds
  /// Video models billed by token: recorded, no estimate before the call.
  output_video_tokens
  /// TTS priced per input character.
  input_characters

  @@map("ai_price_metric")
}

enum AiPriceSource {
  official_api
  official_page
  manual_estimate

  @@map("ai_price_source")
}

enum AiInvocationStatus {
  started
  succeeded
  failed
  outcome_unknown

  @@map("ai_invocation_status")
}

enum AiCostStatus {
  reported
  estimated
  unknown

  @@map("ai_cost_status")
}

enum AiUsageSource {
  provider_reported
  calculated
  manual

  @@map("ai_usage_source")
}

model AiProvider {
  id            String           @id @default(uuid(7)) @db.Uuid
  /// Stable key used in code and config, e.g. "openrouter", "mock".
  key           String           @unique @db.VarChar(64)
  name          String           @db.VarChar(120)
  /// gateway | direct | mock (CHECK).
  kind          String           @db.VarChar(16)
  status        AiProviderStatus @default(disabled)
  termsUrl      String?          @map("terms_url") @db.VarChar(2048)
  dataPolicyUrl String?          @map("data_policy_url") @db.VarChar(2048)
  notes         String?          @db.Text
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  models      AiModel[]
  invocations AiInvocation[]

  @@map("ai_providers")
}

model AiModel {
  id                  String           @id @default(uuid(7)) @db.Uuid
  providerId          String           @map("provider_id") @db.Uuid
  /// Routable model id at the provider, e.g. "deepseek/deepseek-v4-flash".
  modelKey            String           @map("model_key") @db.VarChar(200)
  /// Pinned checkpoint, e.g. "deepseek/deepseek-v4-flash-20260423".
  canonicalSlug       String?          @map("canonical_slug") @db.VarChar(200)
  displayName         String           @map("display_name") @db.VarChar(200)
  /// Request parameters the model supports (ai-core `LlmParameter` vocabulary).
  supportedParameters String[]         @default([]) @map("supported_parameters")
  inputModalities     String[]         @default([]) @map("input_modalities")
  outputModalities    String[]         @default([]) @map("output_modalities")
  contextLength       Int?             @map("context_length")
  maxOutputTokens     Int?             @map("max_output_tokens")
  qualityTier         AiQualityTier    @map("quality_tier")
  /// New models start disabled; enabling is an explicit operator step.
  status              AiProviderStatus @default(disabled)
  /// Rate-limited free variant: never production capacity (CLAUDE.md §2.14).
  isFreeVariant       Boolean          @default(false) @map("is_free_variant")
  rateLimitNotes      String?          @map("rate_limit_notes") @db.Text
  dataPolicyNotes     String?          @map("data_policy_notes") @db.Text
  benchmarkScore      Decimal?         @map("benchmark_score") @db.Decimal(5, 2)
  lastTestedAt        DateTime?        @map("last_tested_at") @db.Timestamptz(3)
  expiresAt           DateTime?        @map("expires_at") @db.Timestamptz(3)
  /// Image models (M4): { maxImages, maxReferences, aspectRatios[], resolutions[], seed } from
  /// the provider's endpoint record; null for other capabilities.
  imageConstraints    Json?            @map("image_constraints") @db.JsonB
  /// Video or TTS limits (M5): `{ kind: "video" | "tts", … }` from the catalog record.
  mediaConstraints    Json?            @map("media_constraints") @db.JsonB
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider     AiProvider          @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  capabilities AiModelCapability[]
  prices       AiModelPrice[]
  invocations  AiInvocation[]

  jobs          GenerationJob[]
  taskRoutes    AiTaskRoute[]
  voiceProfiles VoiceProfile[]

  @@unique([providerId, modelKey])
  @@unique([providerId, id]) // composite-FK target
  @@map("ai_models")
}

model AiModelCapability {
  modelId    String       @map("model_id") @db.Uuid
  capability AiCapability

  model AiModel @relation(fields: [modelId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([modelId, capability])
  @@index([capability])
  @@map("ai_model_capabilities")
}

/// Append-only. A price change is a new row with a later effective_from.
model AiModelPrice {
  id              String        @id @default(uuid(7)) @db.Uuid
  modelId         String        @map("model_id") @db.Uuid
  metric          AiPriceMetric
  /// USD per single unit (one token or one request), exact.
  unitPrice       Decimal       @map("unit_price") @db.Decimal(38, 18)
  /// The value exactly as published, kept when unit_price had to be rounded.
  sourceValue     String        @map("source_value") @db.VarChar(64)
  currency        String        @default("USD") @db.Char(3)
  /// Prompt-size tier: applies to calls with at least this many input tokens.
  minPromptTokens Int           @default(0) @map("min_prompt_tokens")
  /// Output tier the price applies to (image resolution, e.g. "2k"); "" = any request (M4).
  variant         String        @default("") @db.VarChar(32)
  effectiveFrom   DateTime      @map("effective_from") @db.Timestamptz(3)
  source          AiPriceSource
  sourceUrl       String        @map("source_url") @db.VarChar(2048)
  capturedAt      DateTime      @map("captured_at") @db.Timestamptz(3)
  createdById     String?       @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  model        AiModel         @relation(fields: [modelId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  usageRecords AiUsageRecord[]

  @@unique([modelId, metric, minPromptTokens, variant, effectiveFrom])
  @@index([createdById])
  @@map("ai_model_prices")
}

/// One provider call. Written (status started) before the call, updated once with the outcome.
model AiInvocation {
  id                String             @id @default(uuid(7)) @db.Uuid
  projectId         String             @map("project_id") @db.Uuid
  contentItemId     String?            @map("content_item_id") @db.Uuid
  /// GenerationJob link (composite FK since M3).
  generationJobId   String?            @map("generation_job_id") @db.Uuid
  correlationId     String             @map("correlation_id") @db.VarChar(128)
  idempotencyKey    String?            @unique @map("idempotency_key") @db.VarChar(200)
  capability        AiCapability
  providerId        String             @map("provider_id") @db.Uuid
  modelId           String             @map("model_id") @db.Uuid
  servedModel       String?            @map("served_model") @db.VarChar(200)
  providerRequestId String?            @map("provider_request_id") @db.VarChar(200)
  status            AiInvocationStatus @default(started)
  /// ai-core ProviderErrorCode.
  errorCode         String?            @map("error_code") @db.VarChar(64)
  /// Sanitized; never prompt or completion text.
  errorMessage      String?            @map("error_message") @db.VarChar(500)
  /// Request parameters and routing explanation only: never messages or credentials.
  requestSummary    Json               @map("request_summary") @db.JsonB
  finishReason      String?            @map("finish_reason") @db.VarChar(32)
  latencyMs         Int?               @map("latency_ms")
  reportedCost      Decimal?           @map("reported_cost") @db.Decimal(38, 18)
  estimatedCost     Decimal?           @map("estimated_cost") @db.Decimal(38, 18)
  costStatus        AiCostStatus       @default(unknown) @map("cost_status")
  currency          String             @default("USD") @db.Char(3)
  startedAt         DateTime           @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime?          @map("completed_at") @db.Timestamptz(3)

  project      Project         @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contentItem  ContentItem?    @relation(fields: [projectId, contentItemId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  provider     AiProvider      @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  model        AiModel         @relation(fields: [providerId, modelId], references: [providerId, id], onDelete: Restrict, onUpdate: Restrict)
  usageRecords AiUsageRecord[]

  /// Job link (M3; nullable for calls outside jobs, e.g. the operator smoke test).
  generationJob GenerationJob?  @relation(fields: [projectId, generationJobId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Video jobs whose submission this invocation is (M5).
  inFlightJobs  GenerationJob[] @relation("JobInFlightInvocation")

  @@unique([projectId, id]) // composite-FK target
  @@index([projectId, startedAt])
  @@index([providerId, modelId, startedAt])
  @@index([status, startedAt])
  @@index([contentItemId])
  @@index([generationJobId])
  @@map("ai_invocations")
}

/// Append-only per-metric usage of one invocation.
model AiUsageRecord {
  id           String        @id @default(uuid(7)) @db.Uuid
  invocationId String        @map("invocation_id") @db.Uuid
  /// Denormalized for reporting; must equal the invocation's project (composite FK).
  projectId    String        @map("project_id") @db.Uuid
  metric       AiPriceMetric
  quantity     BigInt
  /// Null when no price is known.
  unitPrice    Decimal?      @map("unit_price") @db.Decimal(38, 18)
  cost         Decimal?      @db.Decimal(38, 18)
  priceId      String?       @map("price_id") @db.Uuid
  source       AiUsageSource
  recordedAt   DateTime      @default(now()) @map("recorded_at") @db.Timestamptz(3)

  invocation AiInvocation  @relation(fields: [projectId, invocationId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  price      AiModelPrice? @relation(fields: [priceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([invocationId])
  @@index([projectId, recordedAt])
  @@index([priceId])
  @@map("ai_usage_records")
}

// ----------------------------------------------------------------------------- generation (M3)
// Design: docs/design/M3-design-review-package.md §4, ADR-0013. Job intent is persisted before
// enqueueing; BullMQ carries only the job id. Versions are immutable after insert except their
// one-time review (AC012); approval pointers live on content_items (AC013).

enum GenerationJobKind {
  script_generation
  storyboard_generation
  image_generation
  /// M5: one clip per scene from its keyframe (async provider job).
  video_generation
  /// M5: one voice-over per scene.
  tts_generation
  /// M6: one render of a content item (FFmpeg in the worker; no provider call).
  render

  @@map("generation_job_kind")
}

enum GenerationJobStatus {
  queued
  running
  succeeded
  failed
  canceled

  @@map("generation_job_status")
}

enum ArtifactStatus {
  pending_review
  approved
  rejected

  @@map("artifact_status")
}

enum ArtifactSource {
  generated
  edited

  @@map("artifact_source")
}

/// Minimal production run (M3 Q7): one per generate request.
model ProductionRun {
  id            String              @id @default(uuid(7)) @db.Uuid
  projectId     String              @map("project_id") @db.Uuid
  contentItemId String              @map("content_item_id") @db.Uuid
  status        GenerationJobStatus @default(queued)
  requestedById String              @map("requested_by_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt   DateTime?           @map("completed_at") @db.Timestamptz(3)

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contentItem ContentItem     @relation(fields: [projectId, contentItemId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  requestedBy User            @relation(fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  jobs        GenerationJob[]

  @@unique([projectId, id]) // composite-FK target
  @@index([contentItemId, createdAt])
  @@index([requestedById])
  @@map("production_runs")
}

model GenerationJob {
  id                        String              @id @default(uuid(7)) @db.Uuid
  projectId                 String              @map("project_id") @db.Uuid
  contentItemId             String              @map("content_item_id") @db.Uuid
  productionRunId           String              @map("production_run_id") @db.Uuid
  kind                      GenerationJobKind
  status                    GenerationJobStatus @default(queued)
  /// "{content_item_id}:{kind}" while queued/running, else null: one active job per item and kind.
  activeKey                 String?             @unique @map("active_key") @db.VarChar(80)
  /// Client Idempotency-Key, or derived from the execution key.
  idempotencyKey            String              @unique @map("idempotency_key") @db.VarChar(200)
  /// sha256 of every input (content-domain executionKey).
  executionKey              String              @map("execution_key") @db.Char(64)
  /// Input ids and parameters; never secrets.
  input                     Json                @db.JsonB
  /// Content status the job started from, restored on failure/cancel.
  previousContentStatus     ContentStatus       @map("previous_content_status")
  promptTemplateId          String              @map("prompt_template_id") @db.VarChar(64)
  /// Fully resolved prompt (CONTENT_PIPELINE §4); set when the worker renders it.
  promptSnapshot            String?             @map("prompt_snapshot") @db.Text
  modelId                   String              @map("model_id") @db.Uuid
  attempt                   Int                 @default(0)
  maxAttempts               Int                 @default(3) @map("max_attempts")
  /// The scene an image/video/TTS job generates for (M4/M5); required iff scene-scoped kind.
  storyboardSceneId         String?             @map("storyboard_scene_id") @db.Uuid
  // --- Async provider jobs (M5 design §5, decision V3); video only ---
  /// Adapter that holds the provider job (e.g. `openrouter`).
  providerKey               String?             @map("provider_key") @db.VarChar(64)
  /// The provider's job id; once set it never changes (resume by polling, never resubmit).
  providerJobId             String?             @unique @map("provider_job_id") @db.VarChar(200)
  /// Last provider state seen (`pending`, `running`, `completed`, …).
  providerStatus            String?             @map("provider_status") @db.VarChar(32)
  /// The ledger invocation of the submission in flight (set before the submit call).
  invocationId              String?             @map("invocation_id") @db.Uuid
  /// Set before the paid submit call: with no provider job id, the outcome is unknown.
  submittedAt               DateTime?           @map("submitted_at") @db.Timestamptz(3)
  lastPolledAt              DateTime?           @map("last_polled_at") @db.Timestamptz(3)
  nextPollAt                DateTime?           @map("next_poll_at") @db.Timestamptz(3)
  pollCount                 Int                 @default(0) @map("poll_count")
  /// When the provider's stored output stops being downloadable.
  providerExpiresAt         DateTime?           @map("provider_expires_at") @db.Timestamptz(3)
  resultScriptVersionId     String?             @map("result_script_version_id") @db.Uuid
  resultStoryboardVersionId String?             @map("result_storyboard_version_id") @db.Uuid
  errorCode                 String?             @map("error_code") @db.VarChar(64)
  errorMessage              String?             @map("error_message") @db.VarChar(500)
  requestedById             String              @map("requested_by_id") @db.Uuid
  queuedAt                  DateTime            @default(now()) @map("queued_at") @db.Timestamptz(3)
  startedAt                 DateTime?           @map("started_at") @db.Timestamptz(3)
  completedAt               DateTime?           @map("completed_at") @db.Timestamptz(3)
  updatedAt                 DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  project          Project             @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contentItem      ContentItem         @relation(fields: [projectId, contentItemId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  productionRun    ProductionRun       @relation(fields: [projectId, productionRunId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  model            AiModel             @relation(fields: [modelId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestedBy      User                @relation(fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resultScript     ScriptVersion?      @relation("JobResultScript", fields: [projectId, resultScriptVersionId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  resultStoryboard StoryboardVersion?  @relation("JobResultStoryboard", fields: [projectId, resultStoryboardVersionId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  storyboardScene  StoryboardScene?    @relation("SceneImageJobs", fields: [projectId, storyboardSceneId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  invocation       AiInvocation?       @relation("JobInFlightInvocation", fields: [projectId, invocationId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  assets           Asset[]             @relation("JobAssets")
  render           Render?
  events           JobEvent[]
  invocations      AiInvocation[]
  scripts          ScriptVersion[]     @relation("ScriptGeneratedBy")
  storyboards      StoryboardVersion[] @relation("StoryboardGeneratedBy")

  @@unique([projectId, id]) // composite-FK target
  @@index([contentItemId, kind, executionKey])
  @@index([productionRunId])
  @@index([storyboardSceneId])
  @@index([status, queuedAt])
  @@index([modelId])
  @@index([requestedById])
  @@map("generation_jobs")
}

/// Append-only job state transitions (CLAUDE.md §7).
model JobEvent {
  id         String               @id @default(uuid(7)) @db.Uuid
  projectId  String               @map("project_id") @db.Uuid
  jobId      String               @map("job_id") @db.Uuid
  fromStatus GenerationJobStatus? @map("from_status")
  toStatus   GenerationJobStatus  @map("to_status")
  attempt    Int
  /// Event type and sanitized details (validation paths, error codes); never content.
  detail     Json                 @db.JsonB
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  job GenerationJob @relation(fields: [projectId, jobId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([jobId, createdAt])
  @@map("job_events")
}

model ScriptVersion {
  id               String         @id @default(uuid(7)) @db.Uuid
  projectId        String         @map("project_id") @db.Uuid
  contentItemId    String         @map("content_item_id") @db.Uuid
  version          Int
  status           ArtifactStatus @default(pending_review)
  source           ArtifactSource
  basedOnVersionId String?        @map("based_on_version_id") @db.Uuid
  generationJobId  String?        @map("generation_job_id") @db.Uuid
  schemaVersion    Int            @map("schema_version")
  /// Validated ScriptContent (content-domain).
  content          Json           @db.JsonB
  createdById      String?        @map("created_by_id") @db.Uuid
  reviewedById     String?        @map("reviewed_by_id") @db.Uuid
  reviewedAt       DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  reviewNote       String?        @map("review_note") @db.VarChar(2000)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  contentItem   ContentItem         @relation("ContentScripts", fields: [projectId, contentItemId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  basedOn       ScriptVersion?      @relation("ScriptBasedOn", fields: [contentItemId, basedOnVersionId], references: [contentItemId, id], onDelete: Restrict, onUpdate: Restrict)
  derived       ScriptVersion[]     @relation("ScriptBasedOn")
  generationJob GenerationJob?      @relation("ScriptGeneratedBy", fields: [projectId, generationJobId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy     User?               @relation("ScriptCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewedBy    User?               @relation("ScriptReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedFor   ContentItem[]       @relation("ContentApprovedScript")
  storyboards   StoryboardVersion[]
  jobResults    GenerationJob[]     @relation("JobResultScript")

  @@unique([contentItemId, version])
  @@unique([contentItemId, id]) // composite-FK target (pointer, based-on)
  @@unique([projectId, id]) // composite-FK target
  @@index([generationJobId])
  @@index([createdById])
  @@index([reviewedById])
  @@map("script_versions")
}

model StoryboardVersion {
  id                   String         @id @default(uuid(7)) @db.Uuid
  projectId            String         @map("project_id") @db.Uuid
  contentItemId        String         @map("content_item_id") @db.Uuid
  /// The approved script it was generated from (for edits: the base version's script).
  scriptVersionId      String         @map("script_version_id") @db.Uuid
  version              Int
  status               ArtifactStatus @default(pending_review)
  source               ArtifactSource
  basedOnVersionId     String?        @map("based_on_version_id") @db.Uuid
  generationJobId      String?        @map("generation_job_id") @db.Uuid
  schemaVersion        Int            @map("schema_version")
  totalDurationSeconds Decimal        @map("total_duration_seconds") @db.Decimal(7, 2)
  createdById          String?        @map("created_by_id") @db.Uuid
  reviewedById         String?        @map("reviewed_by_id") @db.Uuid
  reviewedAt           DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  reviewNote           String?        @map("review_note") @db.VarChar(2000)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  contentItem   ContentItem         @relation("ContentStoryboards", fields: [projectId, contentItemId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  script        ScriptVersion       @relation(fields: [contentItemId, scriptVersionId], references: [contentItemId, id], onDelete: Restrict, onUpdate: Restrict)
  basedOn       StoryboardVersion?  @relation("StoryboardBasedOn", fields: [contentItemId, basedOnVersionId], references: [contentItemId, id], onDelete: Restrict, onUpdate: Restrict)
  derived       StoryboardVersion[] @relation("StoryboardBasedOn")
  generationJob GenerationJob?      @relation("StoryboardGeneratedBy", fields: [projectId, generationJobId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy     User?               @relation("StoryboardCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewedBy    User?               @relation("StoryboardReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  scenes        StoryboardScene[]
  renders       Render[]
  approvedFor   ContentItem[]       @relation("ContentApprovedStoryboard")
  jobResults    GenerationJob[]     @relation("JobResultStoryboard")

  @@unique([contentItemId, version])
  @@unique([contentItemId, id]) // composite-FK target
  @@unique([projectId, id]) // composite-FK target
  @@index([scriptVersionId])
  @@index([generationJobId])
  @@index([createdById])
  @@index([reviewedById])
  @@map("storyboard_versions")
}

/// Immutable with its storyboard version (AC012).
model StoryboardScene {
  id                   String   @id @default(uuid(7)) @db.Uuid
  projectId            String   @map("project_id") @db.Uuid
  storyboardVersionId  String   @map("storyboard_version_id") @db.Uuid
  sceneNumber          Int      @map("scene_number")
  durationSeconds      Decimal  @map("duration_seconds") @db.Decimal(6, 2)
  shotType             String   @map("shot_type") @db.VarChar(100)
  cameraAngle          String   @map("camera_angle") @db.VarChar(100)
  cameraMovement       String   @map("camera_movement") @db.VarChar(100)
  characterAction      String   @map("character_action") @db.Text
  characterVersionId   String?  @map("character_version_id") @db.Uuid
  environmentVersionId String?  @map("environment_version_id") @db.Uuid
  visualDescription    String   @map("visual_description") @db.Text
  imagePrompt          String   @map("image_prompt") @db.Text
  videoPrompt          String   @map("video_prompt") @db.Text
  negativePrompt       String   @map("negative_prompt") @db.Text
  voiceOverSegment     String   @map("voice_over_segment") @db.Text
  onScreenText         String   @map("on_screen_text") @db.Text
  acceptanceChecks     String[] @default([]) @map("acceptance_checks")

  storyboardVersion  StoryboardVersion      @relation(fields: [projectId, storyboardVersionId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  characterVersion   CharacterVersion?      @relation(fields: [projectId, characterVersionId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  environmentVersion EnvironmentVersion?    @relation(fields: [projectId, environmentVersionId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  referenceAssets    StoryboardSceneAsset[]
  imageJobs          GenerationJob[]        @relation("SceneImageJobs")
  candidates         Asset[]                @relation("SceneCandidates")
  keyframe           SceneKeyframe?
  keyframeEvents     SceneKeyframeEvent[]
  clip               SceneClip?
  clipEvents         SceneClipEvent[]
  voiceover          SceneVoiceover?
  voiceoverEvents    SceneVoiceoverEvent[]

  @@unique([storyboardVersionId, sceneNumber])
  @@unique([projectId, id]) // composite-FK target
  @@index([characterVersionId])
  @@index([environmentVersionId])
  @@map("storyboard_scenes")
}

model StoryboardSceneAsset {
  projectId String @map("project_id") @db.Uuid
  sceneId   String @map("scene_id") @db.Uuid
  assetId   String @map("asset_id") @db.Uuid

  scene StoryboardScene @relation(fields: [projectId, sceneId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  asset Asset           @relation(fields: [projectId, assetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([sceneId, assetId])
  @@index([assetId])
  @@map("storyboard_scene_assets")
}

/// Model per generation task (M3 Q4), set by the operator CLI.
model AiTaskRoute {
  task              GenerationJobKind @id
  modelId           String            @map("model_id") @db.Uuid
  /// Route only to zero-data-retention endpoints (M4 decision G9; set by the operator).
  zeroDataRetention Boolean           @default(false) @map("zero_data_retention")
  updatedById       String?           @map("updated_by_id") @db.Uuid
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  model     AiModel @relation(fields: [modelId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User?   @relation(fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([modelId])
  @@map("ai_task_routes")
}

// ----------------------------------------------------------------------------- images (M4)
// Design: docs/design/M4-design-review-package.md §4.4, §5.4. Lineage rows are append-only;
// a scene's keyframe is a pointer to an approved image of the same content item (AC015).

/// Reference images sent with a generation (append-only lineage, M4 design §4.4).
model AssetInput {
  projectId    String   @map("project_id") @db.Uuid
  assetId      String   @map("asset_id") @db.Uuid
  inputAssetId String   @map("input_asset_id") @db.Uuid
  /// character | environment | scene_reference (CHECK).
  role         String   @db.VarChar(32)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  asset      Asset @relation("AssetInputsOf", fields: [projectId, assetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  inputAsset Asset @relation("AssetInputsUsed", fields: [projectId, inputAssetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([assetId, inputAssetId])
  @@index([inputAssetId])
  @@map("asset_inputs")
}

/// The selected (approved) image of a storyboard scene: gate 3 input (M4 design §5.4).
model SceneKeyframe {
  storyboardSceneId String   @id @map("storyboard_scene_id") @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  assetId           String   @map("asset_id") @db.Uuid
  selectedById      String   @map("selected_by_id") @db.Uuid
  selectedAt        DateTime @map("selected_at") @db.Timestamptz(3)

  scene      StoryboardScene @relation(fields: [projectId, storyboardSceneId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  asset      Asset           @relation(fields: [projectId, assetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  selectedBy User            @relation(fields: [selectedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([projectId, storyboardSceneId]) // one-to-one through the composite FK
  @@index([assetId])
  @@index([selectedById])
  @@map("scene_keyframes")
}

/// Append-only history of keyframe selections (who chose which image, when).
model SceneKeyframeEvent {
  id                String   @id @default(uuid(7)) @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  storyboardSceneId String   @map("storyboard_scene_id") @db.Uuid
  assetId           String   @map("asset_id") @db.Uuid
  selectedById      String   @map("selected_by_id") @db.Uuid
  /// `selected` by an editor, or `reused` from an identical scene of an older storyboard version.
  reason            String   @db.VarChar(16)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  scene      StoryboardScene @relation(fields: [projectId, storyboardSceneId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  asset      Asset           @relation(fields: [projectId, assetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  selectedBy User            @relation(fields: [selectedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([storyboardSceneId, createdAt])
  @@index([assetId])
  @@index([selectedById])
  @@map("scene_keyframe_events")
}

/// The approved clip of a scene (M5 gate 4, decision V6): a selection pointer like keyframes.
model SceneClip {
  storyboardSceneId String   @id @map("storyboard_scene_id") @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  assetId           String   @map("asset_id") @db.Uuid
  selectedById      String   @map("selected_by_id") @db.Uuid
  selectedAt        DateTime @map("selected_at") @db.Timestamptz(3)

  scene      StoryboardScene @relation(fields: [projectId, storyboardSceneId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  asset      Asset           @relation(fields: [projectId, assetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  selectedBy User            @relation(fields: [selectedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([projectId, storyboardSceneId])
  @@index([assetId])
  @@index([selectedById])
  @@map("scene_clips")
}

/// Append-only history of clip selections (`selected`, `reused`, `cleared` on a keyframe change).
model SceneClipEvent {
  id                String   @id @default(uuid(7)) @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  storyboardSceneId String   @map("storyboard_scene_id") @db.Uuid
  assetId           String   @map("asset_id") @db.Uuid
  selectedById      String   @map("selected_by_id") @db.Uuid
  reason            String   @db.VarChar(16)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  scene      StoryboardScene @relation(fields: [projectId, storyboardSceneId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  asset      Asset           @relation(fields: [projectId, assetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  selectedBy User            @relation(fields: [selectedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([storyboardSceneId, createdAt])
  @@index([assetId])
  @@index([selectedById])
  @@map("scene_clip_events")
}

/// The approved voice-over of a scene (M5, decision V7): generated or imported audio.
model SceneVoiceover {
  storyboardSceneId String   @id @map("storyboard_scene_id") @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  assetId           String   @map("asset_id") @db.Uuid
  selectedById      String   @map("selected_by_id") @db.Uuid
  selectedAt        DateTime @map("selected_at") @db.Timestamptz(3)

  scene      StoryboardScene @relation(fields: [projectId, storyboardSceneId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  asset      Asset           @relation(fields: [projectId, assetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  selectedBy User            @relation(fields: [selectedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([projectId, storyboardSceneId])
  @@index([assetId])
  @@index([selectedById])
  @@map("scene_voiceovers")
}

/// Append-only history of voice-over selections (`selected`, `reused`).
model SceneVoiceoverEvent {
  id                String   @id @default(uuid(7)) @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  storyboardSceneId String   @map("storyboard_scene_id") @db.Uuid
  assetId           String   @map("asset_id") @db.Uuid
  selectedById      String   @map("selected_by_id") @db.Uuid
  reason            String   @db.VarChar(16)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  scene      StoryboardScene @relation(fields: [projectId, storyboardSceneId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  asset      Asset           @relation(fields: [projectId, assetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  selectedBy User            @relation(fields: [selectedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([storyboardSceneId, createdAt])
  @@index([assetId])
  @@index([selectedById])
  @@map("scene_voiceover_events")
}

/// A project's narration voice (M5 design §7.1): TTS model + provider voice + delivery settings.
/// Jobs snapshot every parameter, so editing a profile never changes past outputs.
model VoiceProfile {
  id           String    @id @default(uuid(7)) @db.Uuid
  projectId    String    @map("project_id") @db.Uuid
  name         String    @db.VarChar(120)
  modelId      String    @map("model_id") @db.Uuid
  /// Provider voice id (model-specific), e.g. `sarah` or `vi-VN-Harper:MAI-Voice-2.1`.
  voice        String    @db.VarChar(200)
  /// BCP 47 tag of the narration.
  language     String    @db.VarChar(35)
  speed        Decimal?  @db.Decimal(3, 2)
  instructions String?   @db.VarChar(500)
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(3)
  createdById  String    @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  model        AiModel       @relation(fields: [modelId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contentItems ContentItem[]

  @@unique([projectId, id])
  @@index([projectId, archivedAt])
  @@index([modelId])
  @@index([createdById])
  @@map("voice_profiles")
}

// ----------------------------------------------------------------------------- renders (M6)

enum RenderReviewStatus {
  pending
  approved
  rejected

  @@map("render_review_status")
}

/// One assembled render of a content item (M6 design §4): exactly what was used (manifest and
/// settings frozen at creation), its outputs, QC report and gate-5 review. Never deleted; outputs,
/// QC, review and export are each set once.
model Render {
  id                  String             @id @default(uuid(7)) @db.Uuid
  projectId           String             @map("project_id") @db.Uuid
  contentItemId       String             @map("content_item_id") @db.Uuid
  storyboardVersionId String             @map("storyboard_version_id") @db.Uuid
  generationJobId     String             @map("generation_job_id") @db.Uuid
  /// Per scene: clip, voice-over, keyframe, durations, text; music; source models/jobs.
  manifest            Json               @db.JsonB
  /// Output spec, caption and loudness settings, renderer version.
  settings            Json               @db.JsonB
  /// sha256 of manifest + settings: identical requests reuse a succeeded render.
  executionKey        String             @map("execution_key") @db.Char(64)
  videoAssetId        String?            @map("video_asset_id") @db.Uuid
  subtitleAssetId     String?            @map("subtitle_asset_id") @db.Uuid
  thumbnailAssetId    String?            @map("thumbnail_asset_id") @db.Uuid
  durationMs          Int?               @map("duration_ms")
  /// Lowest source clip height when clips were scaled up (e.g. "720p"); null = native.
  upscaledFrom        String?            @map("upscaled_from") @db.VarChar(16)
  qc                  Json?              @db.JsonB
  reviewStatus        RenderReviewStatus @default(pending) @map("review_status")
  reviewedById        String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt          DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  reviewNote          String?            @map("review_note") @db.VarChar(2000)
  exportedAt          DateTime?          @map("exported_at") @db.Timestamptz(3)
  exportedById        String?            @map("exported_by_id") @db.Uuid
  createdById         String             @map("created_by_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  project        Project           @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contentItem    ContentItem       @relation("ContentRenders", fields: [projectId, contentItemId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  storyboard     StoryboardVersion @relation(fields: [projectId, storyboardVersionId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  generationJob  GenerationJob     @relation(fields: [projectId, generationJobId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  videoAsset     Asset?            @relation("RenderVideo", fields: [projectId, videoAssetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  subtitleAsset  Asset?            @relation("RenderSubtitle", fields: [projectId, subtitleAssetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  thumbnailAsset Asset?            @relation("RenderThumbnail", fields: [projectId, thumbnailAssetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  reviewedBy     User?             @relation("RenderReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  exportedBy     User?             @relation("RenderExportedBy", fields: [exportedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy      User              @relation("RenderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedFor    ContentItem[]     @relation("ContentApprovedRender")

  @@unique([projectId, id])
  @@unique([contentItemId, id]) // gate-5 pointer target
  @@unique([projectId, generationJobId])
  @@index([contentItemId, createdAt(sort: Desc)])
  @@index([storyboardVersionId])
  @@index([videoAssetId])
  @@index([subtitleAssetId])
  @@index([thumbnailAssetId])
  @@index([reviewedById])
  @@index([exportedById])
  @@index([createdById])
  @@map("renders")
}
