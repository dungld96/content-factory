{
  "name": "@acf/ai-core",
  "version": "0.0.0",
  "private": true,
  "description": "Provider-agnostic AI capability interfaces, normalized errors, money, pricing, routing and test doubles.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./openrouter": {
      "types": "./dist/openrouter/index.d.ts",
      "default": "./dist/openrouter/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@acf/config": "workspace:*",
    "zod": "4.6.7"
  }
}
