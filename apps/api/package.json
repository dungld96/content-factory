{
  "name": "@acf/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS REST API for AI Content Factory.",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=../../.env --enable-source-maps\"",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "user": "node --env-file-if-exists=../../.env --enable-source-maps dist/cli/user-cli.js",
    "seed": "node --env-file-if-exists=../../.env --enable-source-maps dist/cli/seed.js"
  },
  "dependencies": {
    "@acf/config": "workspace:*",
    "@acf/contracts": "workspace:*",
    "@acf/database": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/throttler": "6.7.1",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "csrf-csrf": "4.1.0",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.13",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "pg": "8.23.1",
    "supertest": "7.3.1"
  }
}
