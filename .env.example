# Copy to `.env` for local development:  cp .env.example .env
# `.env` is git-ignored. Never commit real credentials. Provider API keys are NOT used in M0.

# --- Local infrastructure (infra/compose/docker-compose.yml) -------------------
POSTGRES_USER=acf
# Local-only development password. Change it if your machine is shared.
POSTGRES_PASSWORD=acf_local_dev_only
POSTGRES_DB=acf
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- API (apps/api) — validated by packages/config/src/api-env.ts -------------
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
LOG_JSON=false
DATABASE_URL=postgresql://acf:acf_local_dev_only@localhost:5432/acf?schema=public
REDIS_URL=redis://localhost:6379
HEALTH_CHECK_TIMEOUT_MS=2000

# --- Web (apps/web) — validated by packages/config/src/web-env.ts -------------
# Server-side only; the browser never receives this value.
API_INTERNAL_URL=http://localhost:4000
