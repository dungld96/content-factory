# Copy to `.env` for local development:  cp .env.example .env
# `.env` is git-ignored. Never commit real credentials. Provider API keys are not used yet.

# --- Local infrastructure (infra/compose/docker-compose.yml) -------------------
POSTGRES_USER=acf
# Local-only development password. Change it if your machine is shared.
POSTGRES_PASSWORD=acf_local_dev_only
POSTGRES_DB=acf
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Database roles (local development and CI only) ---------------------------
# `pnpm db:setup` creates the roles/databases from these URLs and applies migrations.
# Superuser (the compose POSTGRES_USER). Used only by db:setup and the integration-test setup.
DATABASE_ADMIN_URL=postgresql://acf:acf_local_dev_only@localhost:5432/acf
# Schema owner: migrations, seed, test setup.
DATABASE_MIGRATION_URL=postgresql://acf_migrator:acf_migrator_local_dev_only@localhost:5432/acf?schema=public
# Shadow database for `prisma migrate dev` (owned by acf_migrator, created by db:setup).
DATABASE_SHADOW_URL=postgresql://acf_migrator:acf_migrator_local_dev_only@localhost:5432/acf_shadow?schema=public

# --- API (apps/api) — validated by packages/config/src/api-env.ts -------------
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
LOG_JSON=false
# Runtime role: DML only (SELECT/INSERT/UPDATE/DELETE). See ADR-0011 §8.
DATABASE_URL=postgresql://acf_app:acf_app_local_dev_only@localhost:5432/acf?schema=public
# Max pooled connections, and how long a query waits for a free one (ms).
DATABASE_POOL_MAX=10
DATABASE_POOL_TIMEOUT_MS=10000
REDIS_URL=redis://localhost:6379
# Readiness-probe deadline per dependency (ms). Does not limit application queries.
HEALTH_CHECK_TIMEOUT_MS=2000

# --- Web (apps/web) — validated by packages/config/src/web-env.ts -------------
# Server-side only; the browser never receives this value.
API_INTERNAL_URL=http://localhost:4000
