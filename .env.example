# Copy to `.env` for local development:  cp .env.example .env
# `.env` is git-ignored. Never commit real credentials. Provider API keys stay server-side (apps/api only).

# --- Local infrastructure (infra/compose/docker-compose.yml) -------------------
POSTGRES_USER=acf
# Local-only development password. Change it if your machine is shared.
POSTGRES_PASSWORD=acf_local_dev_only
POSTGRES_DB=acf
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Database roles (local development and CI only) ---------------------------
# `pnpm db:setup` creates the roles/databases from these URLs and applies migrations.
# Superuser (the compose POSTGRES_USER). Used only by db:setup and the integration-test setup.
DATABASE_ADMIN_URL=postgresql://acf:acf_local_dev_only@localhost:5432/acf
# Schema owner: migrations, seed, test setup.
DATABASE_MIGRATION_URL=postgresql://acf_migrator:acf_migrator_local_dev_only@localhost:5432/acf?schema=public
# Shadow database for `prisma migrate dev` (owned by acf_migrator, created by db:setup).
DATABASE_SHADOW_URL=postgresql://acf_migrator:acf_migrator_local_dev_only@localhost:5432/acf_shadow?schema=public

# --- API (apps/api) — validated by packages/config/src/api-env.ts -------------
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
LOG_JSON=false
# Runtime role: DML only (SELECT/INSERT/UPDATE/DELETE). See ADR-0011 §8.
DATABASE_URL=postgresql://acf_app:acf_app_local_dev_only@localhost:5432/acf?schema=public
# Max pooled connections, and how long a query waits for a free one (ms).
DATABASE_POOL_MAX=10
DATABASE_POOL_TIMEOUT_MS=10000
REDIS_URL=redis://localhost:6379
# Readiness-probe deadline per dependency (ms). Does not limit application queries.
HEALTH_CHECK_TIMEOUT_MS=2000
# Reject PATCH/approve requests without If-Match (428). Keep false until all clients send it.
REQUIRE_IF_MATCH=false
# Serve GET /api/v1/openapi.json without auth. Defaults to true outside production.
# OPENAPI_PUBLIC=true

# --- Authentication (ADR-0009) ------------------------------------------------
# Generate each with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Comma-separated; the first signs new cookies, all verify (rotation).
SESSION_SECRETS=replace-with-a-random-string-of-at-least-32-chars
# Must differ from every session secret.
CSRF_SECRET=replace-with-another-random-string-of-32-plus-chars
# Local HTTP development: false (cookie `acf_sid`). Production requires true (`__Host-acf_sid`).
SESSION_COOKIE_SECURE=false
# Proxy hops trusted for X-Forwarded-* (the Next.js server). Never `true` in production.
TRUST_PROXY=loopback
# Origins allowed to send state-changing requests (the web app).
WEB_ORIGINS=http://localhost:3000
# SESSION_IDLE_TTL_MS=86400000
# SESSION_ABSOLUTE_TTL_MS=604800000
# LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- AI providers (M2; docs/design/M2-design-review-package.md §8.3) ----------
# OpenRouter API key (sk-or-v1-…). Leave empty: the provider stays unconfigured and is never
# called. Automated tests never need it and cannot reach openrouter.ai (network guard).
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_MS=120000
# Per video HTTP call (submit, status read, download) and per TTS call (M5).
# OPENROUTER_VIDEO_TIMEOUT_MS=120000
# OPENROUTER_TTS_TIMEOUT_MS=120000
# App attribution headers feed OpenRouter's public rankings and identify this deployment.
# OPENROUTER_APP_ATTRIBUTION=false
# OPENROUTER_APP_URL=
# OPENROUTER_APP_TITLE=

# --- Object storage (M4a; SeaweedFS in infra/compose, ADR-0006) ---------------
# Local-development values only. `pnpm infra:up` starts SeaweedFS with these keys;
# `pnpm storage:setup` creates the bucket. Leave the S3_* group empty to run without storage
# (uploads and image generation then answer 503 STORAGE_NOT_CONFIGURED).
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=acf-assets
S3_ACCESS_KEY_ID=acf_app_local
S3_SECRET_ACCESS_KEY=acf_app_local_dev_only
# S3_FORCE_PATH_STYLE=true
# S3_PORT=8333
# Bucket setup and integration tests only; never given to the API or worker.
STORAGE_ADMIN_ACCESS_KEY_ID=acf_storage_admin_local
STORAGE_ADMIN_SECRET_ACCESS_KEY=acf_storage_admin_local_dev_only
# Largest accepted image upload in bytes (default 25 MB).
# UPLOAD_MAX_IMAGE_BYTES=26214400
# Largest accepted audio upload in bytes (default 25 MB, M5a).
# UPLOAD_MAX_AUDIO_BYTES=26214400
# Video spend guard until M7 budgets: largest estimate (USD) one request may queue.
# VIDEO_MAX_ESTIMATED_USD_PER_REQUEST=5
# FFprobe/FFmpeg binaries (M5a; API and worker). Defaults: found on PATH.
# FFPROBE_PATH=ffprobe
# FFMPEG_PATH=ffmpeg
# MEDIA_TOOL_TIMEOUT_MS=30000

# --- Web (apps/web) — validated by packages/config/src/web-env.ts -------------
# Server-side only; the browser never receives this value.
API_INTERNAL_URL=http://localhost:4000
